# 番茄作家后台鉴权（从浏览器登录后抓任意 author 接口请求获取）
# 1) 登录 https://fanqienovel.com 作家后台
# 2) F12 → Network → 任选一个 /api/author/... 请求
# 3) 复制完整 Cookie 头 → TOMATO_COOKIE
# 4) 复制请求头里的 X-Secsdk-Csrf-Token → TOMATO_CSRF_TOKEN（会话级固定值）
TOMATO_COOKIE=
TOMATO_CSRF_TOKEN=

# 可选：默认操作的小说 book_id（不设则用 data/state.json 里 switch_novel 选中的，或第一本）
TOMATO_DEFAULT_BOOK_ID=
